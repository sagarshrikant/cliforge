@schema 1

# ERROR: meta block is never closed (missing '}').
# TODO: once the parser validates required blocks, this can be changed to
#       a schema with a valid meta-less body and exit should still be non-zero.
meta {
  prefix = "bad"
  output = "cmdline_bad"

option verbose {
  type = flag
  help = "Orphaned option inside unclosed meta."
}
