# =============================================================================
# cliforge — mono-repo .gitignore
# =============================================================================

# ----------------------------------------------------------------------------
# CMake build artefacts
# ----------------------------------------------------------------------------
build/
build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json
cliforge_version.h

# Generated header (produced by cmake/version.cmake at configure time)
include/cliforge_version.h

# Packaging staging dirs
_CPack_Packages/
*.deb
*.rpm
*.tar.gz
*.tar.xz

# ----------------------------------------------------------------------------
# VSCode extension
# ----------------------------------------------------------------------------
tools/vscode-schema-ext/node_modules/
tools/vscode-schema-ext/out/
tools/vscode-schema-ext/*.vsix

# ----------------------------------------------------------------------------
# Editor / IDE
# ----------------------------------------------------------------------------
# Nested .vscode dirs inside sub-projects (e.g. the extension tooling) are
# personal/editor-local — never track them.
tools/**/.vscode/

# Root .vscode: ignore personal/editor-local state, but DO share the project's
# checked-in dev configs (tasks, launch, IntelliSense, settings, recommended
# extensions) so every contributor gets the same build/test/debug experience.
/.vscode/*
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/settings.json
!/.vscode/c_cpp_properties.json
!/.vscode/extensions.json
.idea/

# clangd / CMake local index cache
.cache/
*.swp
*.swo
*~

# ----------------------------------------------------------------------------
# OS
# ----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ----------------------------------------------------------------------------
# Misc
# ----------------------------------------------------------------------------
*.o
*.a
*.so
*.log
*.venv

# ----------------------------------------------------------------------------
# UTest Agent generated output
# ----------------------------------------------------------------------------
coverage_report/
utest_*report*.md
*.gcda
*.gcno

tools/utest_agent/__pycache__/
